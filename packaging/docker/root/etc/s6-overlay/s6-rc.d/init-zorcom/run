#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# The image carries one locale (en_US.UTF-8): make the one LANG names, so that LANG=de_DE.UTF-8 works without 230 MB of locales-all.
if [[ -n ${LANG} ]] && ! locale -a 2>/dev/null | grep -qixF "$(sed -E 's/\.utf-?8$/.utf8/I' <<<"${LANG}")"; then
    echo "**** Eye of ZorCom: making the locale ${LANG} ****"
    locale-gen "${LANG}" >/dev/null || echo "**** Eye of ZorCom: no locale ${LANG} ****"
fi

# Lets the app user open the radios passed in with --device /dev/bus/usb. Only the radios Eye of ZorCom knows (its own udev rules) are
# changed, and only the container's copies of their device files: nothing changes on the host. A radio plugged in later needs a
# restart of the container (Docker copies the device files at the start).
RULES=/usr/lib/udev/rules.d/60-zorcom-sdr.rules
[[ -d /dev/bus/usb && -r ${RULES} ]] || exit 0
# "vvvv:pppp", and "vvvv:" for the rules that take every product of a maker (SDRplay)
IDS=$(sed -nE '/^#/d; s/.*idVendor\}=="([0-9a-fA-F]{4})"(.*idProduct\}=="([0-9a-fA-F]{4})")?.*/\1:\3/p' "${RULES}" | tr 'A-F' 'a-f')
for dev in /sys/bus/usb/devices/*; do
    [[ -r ${dev}/idVendor && -r ${dev}/busnum ]] || continue
    vid=$(<"${dev}/idVendor"); pid=$(<"${dev}/idProduct")
    grep -qxF -e "${vid}:${pid}" -e "${vid}:" <<<"${IDS}" || continue
    node=$(printf '/dev/bus/usb/%03d/%03d' "$(<"${dev}/busnum")" "$(<"${dev}/devnum")")
    [[ -c ${node} ]] || continue
    chgrp abc "${node}" && chmod g+rw "${node}" \
        && echo "**** Eye of ZorCom: radio ${vid}:${pid} $(cat "${dev}/product" 2>/dev/null) at ${node} ****"
done
