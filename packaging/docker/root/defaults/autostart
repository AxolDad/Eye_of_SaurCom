#!/bin/sh
# Started by the desktop session. Selkies preloads a stand-in libudev (for its virtual gamepads) into the session; libusb lists the
# USB devices through libudev, so with it Eye of SaurCom finds no radio. Eye of SaurCom needs no gamepad: start it without the preload.
unset LD_PRELOAD
# the log a bug report needs (radio scan, errors): /config/saurcom.log, started afresh at every start
exec saurcom > /config/saurcom.log 2>&1
