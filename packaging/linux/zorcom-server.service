# Eye of ZorCom headless server as a systemd service (docs/headless-server.md).
#   sudo useradd --system --home /var/lib/zorcom --create-home --groups plugdev zorcom      (plugdev: access to the USB radios; install the udev rules of your radio)
#   sudo cp zorcom-server /usr/local/bin/ && sudo cp zorcom-server.service /etc/systemd/system/
#   sudo -u zorcom zorcom-server --config /var/lib/zorcom/server.conf --lan --new-token       (once: makes the settings file and prints the access token)
#   sudo systemctl enable --now zorcom-server
[Unit]
Description=Eye of ZorCom headless server (software radio controlled from a web browser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zorcom
Group=plugdev
ExecStart=/usr/local/bin/zorcom-server --config /var/lib/zorcom/server.conf
Restart=on-failure
RestartSec=5
StateDirectory=zorcom
StateDirectoryMode=0750
# the radio needs the USB bus; everything else is closed
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
# a Raspberry Pi 4 or better; the receiver's threads should not be starved by other work
Nice=-5

[Install]
WantedBy=multi-user.target
